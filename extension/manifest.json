{
  "manifest_version": 3,
  "name": "Credit Card Offer Checker",
  "version": "0.1.0",
  "description": "Shows available credit card offers for the site you are visiting.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://offers-api.chris-yecora.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Credit Card Offer Checker",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.css"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
